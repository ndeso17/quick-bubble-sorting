<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sort Visualizer</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: "Segoe UI", sans-serif;
        background: #0d0d0d;
        color: #f0f0f0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1rem;
      }
      .wrap { width: 100%; max-width: 760px; }
      h1 {
        text-align: center;
        font-size: 2rem;
        margin-bottom: 1.2rem;
        color: #d6d6d6;
      }
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 14px;
      }
      a.card {
        text-decoration: none;
        color: inherit;
        background: #1a1a1a;
        border: 1px solid #303030;
        border-radius: 10px;
        padding: 1rem;
        transition: border-color .15s ease, transform .15s ease;
      }
      a.card:hover {
        border-color: #6f6f6f;
        transform: translateY(-2px);
      }
      .title { font-size: 1.1rem; margin-bottom: .35rem; }
      .desc { font-size: .9rem; color: #9a9a9a; line-height: 1.4; }
      .bubble .title { color: #e8b84b; }
      .quick .title { color: #5dcaa5; }
    </style>
  </head>
  <body>
    <main class="wrap">
      <h1>Pilih Visualizer</h1>
      <section class="cards">
        <a class="card bubble" href="/bubble">
          <div class="title">Bubble Sort</div>
          <div class="desc">Parallel odd-even transposition dengan kontrol resource host.</div>
        </a>
        <a class="card quick" href="/quick">
          <div class="title">Quick Sort</div>
          <div class="desc">Quick sort paralel berbasis worker partition task.</div>
        </a>
      </section>
    </main>
  </body>
</html>
